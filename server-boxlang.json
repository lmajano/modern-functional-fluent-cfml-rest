{
    "name":"fluentapi-boxlang",
    "app":{
        "serverHomeDirectory":".engine/boxlang",
        "cfengine":"boxlang@be"
    },
    "web":{
        "http":{
            "port":"60147"
        },
        "rewrites":{
            "enable":"true"
        }
    },
    "JVM":{
        "javaVersion":"openjdk21_jdk",
        "args":"-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=8889"
    },
    "cfconfig":{
        "file":".cfconfig.json"
    },
    "env":{
        "BOXLANG_DEBUG":true
    },
    "scripts":{
        "onServerInitialInstall":"install bx-compat-cfml,bx-unsafe-evaluate,bx-mysql"
    }
}
